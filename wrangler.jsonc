{
	"$schema": "node_modules/wrangler/config-schema.json",
	// OpenNext output
	"main": "custom-worker.js",
	// Change to your preferred worker name.
	"name": "umami-prod",
	// Keep this date <= today.
	"compatibility_date": "2026-03-15",
	"compatibility_flags": [
		// Enable Node.js compatibility APIs (required by Next.js/OpenNext)
		"nodejs_compat",
		// Allow to fetch public URLs in your app
		"global_fetch_strictly_public"
	],
	// Static assets generated by OpenNext
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Self reference binding used by OpenNext
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "umami-prod"
		}
	],
  // Hyperdrive binding for Supabase Postgres (recommended)
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9993582424974d5f8cc01b4ff6fb4401",
      // Used only for `wrangler dev` (optional). Can point to local Postgres or Supabase directly.
      "localConnectionString": "postgresql://user:pass@localhost:5432/umami"
    }
  ],
	// Optional: bind a custom domain via routes (or manage it in Cloudflare dashboard)
	// "routes": [
	//   { "pattern": "analytics.example.com/*", "zone_name": "example.com" }
	// ]
}
